# Writes the build identity header used by the performance report
# (src/NppPerfDiagnostics.mm). Run at build time by the npp_build_info target:
#   cmake -DSRC=<source dir> -DOUT=<header> -DBUILD_TYPE=<type> -P NppBuildInfo.cmake
# The header is rewritten only when its content changes, so an unchanged
# commit does not trigger a rebuild.

set(_commit "unknown")
set(_branch "unknown")
set(_dirty 0)
find_program(_git git)
if(_git)
    execute_process(COMMAND ${_git} -C "${SRC}" rev-parse --short=12 HEAD
        OUTPUT_VARIABLE _out RESULT_VARIABLE _rc OUTPUT_STRIP_TRAILING_WHITESPACE ERROR_QUIET)
    if(_rc EQUAL 0)
        set(_commit "${_out}")
    endif()
    execute_process(COMMAND ${_git} -C "${SRC}" rev-parse --abbrev-ref HEAD
        OUTPUT_VARIABLE _out RESULT_VARIABLE _rc OUTPUT_STRIP_TRAILING_WHITESPACE ERROR_QUIET)
    if(_rc EQUAL 0)
        set(_branch "${_out}")
    endif()
    execute_process(COMMAND ${_git} -C "${SRC}" status --porcelain --untracked-files=no
        OUTPUT_VARIABLE _out RESULT_VARIABLE _rc OUTPUT_STRIP_TRAILING_WHITESPACE ERROR_QUIET)
    if(_rc EQUAL 0 AND NOT "${_out}" STREQUAL "")
        set(_dirty 1)
    endif()
endif()

set(_content "// Generated by cmake/NppBuildInfo.cmake. Do not edit.
#pragma once
#define NPP_BUILD_COMMIT \"${_commit}\"
#define NPP_BUILD_BRANCH \"${_branch}\"
#define NPP_BUILD_DIRTY ${_dirty}
#define NPP_BUILD_TYPE \"${BUILD_TYPE}\"
")

set(_old "")
if(EXISTS "${OUT}")
    file(READ "${OUT}" _old)
endif()
if(NOT "${_old}" STREQUAL "${_content}")
    file(WRITE "${OUT}" "${_content}")
endif()
