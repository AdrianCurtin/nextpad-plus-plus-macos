<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<!-- Finder Sync extensions must be sandboxed. The extension needs no file
     access: it reads Finder's selection as URLs and sends the paths to
     Nextpad++ in a distributed notification, and the app (not sandboxed)
     opens them. -->
<dict>
    <key>com.apple.security.app-sandbox</key>
    <true/>
</dict>
</plist>
